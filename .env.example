# Domaine (ou IP/localhost pour un test local) pointant vers ce serveur.
# Utilisé par Caddy pour le certificat TLS et par le frontend pour appeler l'API.
DOMAIN=votre-domaine.com

# Secret utilisé pour signer les tokens JWT. Générez une valeur aléatoire :
#   openssl rand -hex 32
JWT_SECRET=changez-cette-valeur-en-production
